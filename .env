# Authentication API users. Use the CLI documented in README.md to generate entries.
# This value must be a JSON array. With [] configured, every login is rejected.
AUTH_API_USERS=[]

# Generate two different values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REFRESH_TOKEN_PEPPER=
JWT_ISSUER=uploader-and-txt-maker
JWT_AUDIENCE=uploader-api
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_DAYS=30

# Process-local login protection
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PER_IDENTIFIER=10
AUTH_RATE_LIMIT_PER_IP=50
# Keep Argon2 memory usage bounded under concurrent login traffic.
AUTH_PASSWORD_HASH_CONCURRENCY=2
DEFAULT_PHONE_REGION=IN

# Telegram bot
BOT_ENABLED=true
API_ID=
API_HASH=
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (not API users).
AUTH_USERS=
GROUPS=

# Admin-only persistent HTTP cookie session. The endpoint must return Set-Cookie.
ADMIN_USER_ID=
COOKIE_AUTH_URL=
COOKIE_AUTH_IDENTIFIER=
COOKIE_AUTH_PASSWORD=
COOKIE_AUTH_IDENTIFIER_FIELD=identifier
COOKIE_AUTH_PASSWORD_FIELD=password
# json sends application/json; form sends application/x-www-form-urlencoded.
COOKIE_AUTH_REQUEST_FORMAT=json
COOKIE_AUTH_TIMEOUT_SECONDS=30
COOKIE_AUTH_EXTRA_FIELDS={}
COOKIE_AUTH_HEADERS={}

# Optional, only needed for videos.classplusapp links
CLASSPLUS_ACCESS_TOKEN=

# Optional comma-separated browser origins, for example https://app.example.com
CORS_ORIGINS=

# Railway traffic reaches Uvicorn through its reverse proxy.
FORWARDED_ALLOW_IPS=*
