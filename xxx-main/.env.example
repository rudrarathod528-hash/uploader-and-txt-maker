# Railway PostgreSQL and Redis variables
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379/0

# Generate two different values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REFRESH_TOKEN_PEPPER=
JWT_ISSUER=uploader-and-txt-maker
JWT_AUDIENCE=uploader-api
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_DAYS=30

# Login protection
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PER_IDENTIFIER=10
AUTH_RATE_LIMIT_PER_IP=50
# Keep Argon2 memory usage bounded under concurrent login traffic.
AUTH_PASSWORD_HASH_CONCURRENCY=2
DEFAULT_PHONE_REGION=IN

# Telegram bot
BOT_ENABLED=true
API_ID=
API_HASH=
BOT_TOKEN=
AUTH_USERS=
GROUPS=

# Optional, only needed for videos.classplusapp links
CLASSPLUS_ACCESS_TOKEN=

# Optional comma-separated browser origins, for example https://app.example.com
CORS_ORIGINS=

# Railway traffic reaches Uvicorn through its reverse proxy.
FORWARDED_ALLOW_IPS=*
